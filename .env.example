MESH_API_KEY=
MESH_MODEL=openai/gpt-4o
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small
# Increment to invalidate vectors when an embedding deployment changes under the same model ID.
MESH_EMBEDDING_REVISION=1
DEEPDIVE_DATA_DIR=data
# API and clients share this token. Generate one with the setup command.
DEEPDIVE_API_TOKEN=
DEEPDIVE_API_URL=http://127.0.0.1:8000
# Optional local UI login; required on Railway. Use a random value of at least 24 characters.
# Everyone admitted shares one workspace. This is separate from the internal API token.
DEEPDIVE_DEMO_ACCESS_CODE=
# Optional: sanitized exception reporting. Empty keeps error records local.
SENTRY_DSN=
DEEPDIVE_RELEASE=local
# To deploy a published image, set ghcr.io/OWNER/REPO@sha256:DIGEST.
DEEPDIVE_IMAGE=deepdive:local
