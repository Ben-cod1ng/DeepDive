MESH_API_KEY=
MESH_MODEL=openai/gpt-4o
DEEPDIVE_DATA_DIR=data
# API and clients share this token. Generate one with the setup command.
DEEPDIVE_API_TOKEN=
DEEPDIVE_API_URL=http://127.0.0.1:8000
# Optional: sanitized exception reporting. Empty keeps error records local.
SENTRY_DSN=
DEEPDIVE_RELEASE=local
# To deploy a published image, set ghcr.io/OWNER/REPO@sha256:DIGEST.
DEEPDIVE_IMAGE=deepdive:local
